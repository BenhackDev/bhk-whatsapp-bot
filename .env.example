# ============================================
# BHK WhatsApp Bot — Variables de entorno
# Copia este archivo a ".env" y completa los valores:
#   cp .env.example .env   (Linux/macOS/Termux)
#   copy .env.example .env (Windows)
# ============================================

# ===== Sesión de WhatsApp =====
# Nombre de la carpeta donde se guardará la sesión vinculada
# (cada SESSION_NAME distinto genera un QR independiente)
SESSION_NAME=session-client-one

# ===== Base de datos (MySQL — opcional) =====
# Si no configuras MySQL, el bot funciona igual,
# solo se desactiva el registro de usuarios y uso.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bhk_bot

# ===== IA — Gemini (obligatoria para .ia, .img, .img-ia) =====
# Obtén tu clave gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Texto a voz — ElevenLabs (opcional) =====
# Si está vacía, el bot usa el TTS gratuito de Google.
# Obtén tu clave en: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ===== Prefijos de comandos =====
# Lista separada por comas. Ej: .menu, #menu, /menu, $menu, !menu, %menu
PREFIX_LIST=.,#,/,$,!,%

# ===== Personalidad del bot =====
# Nombre y creador que aparecen en la firma de todos los mensajes
# (también los usa el comando .creador y la IA en .ia)
BOT_NAME=BHK-BOT
CREATOR_NAME=Tutos Benhack
CREATOR_YOUTUBE=https://www.youtube.com/@Tutos_benhack
CREATOR_TIKTOK=https://www.tiktok.com/@tutosbenhack
CREATOR_GITHUB=https://github.com/tutosbenhack

# ===== Sistema de logs (LOG_LEVEL) =====
# Niveles disponibles:
#   silent -> solo errores críticos
#   info   -> información importante (por defecto)
#   debug  -> información para desarrolladores
#   trace  -> absolutamente todo (logs de librerías)
LOG_LEVEL=info

# ===== Chequeo de actualizaciones =====
# Avisa en la terminal cuando hay una versión más reciente del bot en GitHub
# (compara tu commit local con la rama main). Pon false para desactivarlo.
CHECK_UPDATES=true
